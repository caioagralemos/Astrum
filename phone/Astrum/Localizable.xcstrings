          }
        }
      }
    },
    "Astra remembers what this conversation is about for 30 minutes, so you can ask follow-ups like 'and yesterday?'. Each answer is still checked on its own." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
