    "Astrum cannot check a reading in %@: enter it by hand." : {
      "comment" : "A note that a value in a given unit cannot be checked because the unit is unknown.",
      "isCommentAutoGenerated" : true
    },
    "Astrum is a companion to the station's hub. It finds the hub on the station's Wi-Fi." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Astrum acompanha o hub da estação. Ele encontra o hub no Wi-Fi da estação."
          }
        }
      }
    },
    "Astrum is checking on you" : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Astrum está verificando como você está"
          }
        }
      }
    },
    "Astrum is not allowed to use the camera. You can allow it in Settings, or choose a photo or type the values instead." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Astrum não tem permissão para usar a câmera. Você pode permitir nos Ajustes, ou escolher uma foto ou digitar os valores."
          }
        }
      }
    },
    "Astrum reads the numbers on this phone. It is not connected to the analyser: you check every value before it is sent." : {
      "comment" : "A description of the functionality of the blood analyser.",
      "isCommentAutoGenerated" : true
    },
    "Astrum reads your Apple Watch's readings from Health and sends them to the hub. It writes nothing to Health. You can skip this." : {
      "localizations" : {
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Astrum lê as leituras do seu Apple Watch no Saúde e as envia ao hub. Ele não grava nada no Saúde. Você pode pular isto."
